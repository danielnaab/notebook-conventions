# Local and runtime artifacts
.DS_Store
.local/
.direnv/
result
result-*
__pycache__/
.pi/sessions/
.pi/settings.local.json
.claude/settings.local.json

# Obsidian: shared core settings and reviewed plugin settings are tracked; per-device state is not
notebook/.obsidian/workspace*.json
notebook/.obsidian/cache/
notebook/.obsidian/plugins/*
!notebook/.obsidian/plugins/calendar/
!notebook/.obsidian/plugins/obsidian-linter/
notebook/.obsidian/plugins/*/*
!notebook/.obsidian/plugins/calendar/data.json
!notebook/.obsidian/plugins/obsidian-linter/data.json
notebook/.obsidian/themes/
.trash/

# Credential material never belongs in this repository
.env
.env.*
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx
