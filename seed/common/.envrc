# The dev shell comes from the pinned kit, which `nix run .#graft` writes into .scions/. Watching the
# kit's wiring reloads this shell after a graft or an upgrade, which `use flake` alone would miss.
wiring=.scions/notebook-conventions/nix/workspace.nix
watch_file "$wiring"
if [ -f "$wiring" ]; then
  use flake
else
  log_status "no dev shell yet: run nix run .#graft"
fi
