// Mirrors the one rule enabled in .obsidian/plugins/obsidian-linter/data.json
// ("Heading blank lines"). Keep this file in sync with that plugin config.
{
  "config": {
    "default": false,
    "MD022": { "lines_above": 1, "lines_below": 1 }
  },
  "globs": ["**/*.md"],
  "ignores": [".scions/**", ".direnv/**", ".local/**", ".workmux/**", "node_modules/**"],
  "gitignore": true
}
